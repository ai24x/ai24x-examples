{
  "version": "1.0.0",
  "description": "AI24X会员系统数据库架构",
  "createdAt": "2026-03-18T08:30:00+08:00",
  "updatedAt": "2026-03-18T08:30:00+08:00",
  
  "tables": {
    "users": {
      "description": "用户主表",
      "fields": {
        "id": { "type": "integer", "primaryKey": true, "autoIncrement": true },
        "username": { "type": "string", "required": true, "unique": true, "maxLength": 50 },
        "email": { "type": "string", "required": true, "unique": true, "maxLength": 100 },
        "passwordHash": { "type": "string", "required": true, "minLength": 60, "maxLength": 255 },
        "displayName": { "type": "string", "maxLength": 100 },
        "avatar": { "type": "string", "maxLength": 255 },
        "phone": { "type": "string", "maxLength": 20 },
        "status": { 
          "type": "enum", 
          "values": ["active", "inactive", "suspended", "pending"],
          "default": "pending"
        },
        "role": {
          "type": "enum",
          "values": ["user", "premium", "admin", "super_admin"],
          "default": "user"
        },
        "emailVerified": { "type": "boolean", "default": false },
        "phoneVerified": { "type": "boolean", "default": false },
        "lastLoginAt": { "type": "datetime" },
        "loginCount": { "type": "integer", "default": 0 },
        "failedLoginAttempts": { "type": "integer", "default": 0 },
        "lockedUntil": { "type": "datetime" },
        "createdAt": { "type": "datetime", "required": true },
        "updatedAt": { "type": "datetime", "required": true }
      },
      "indexes": [
        { "fields": ["email"], "unique": true },
        { "fields": ["username"], "unique": true },
        { "fields": ["status"] },
        { "fields": ["role"] },
        { "fields": ["createdAt"] }
      ]
    },
    
    "user_profiles": {
      "description": "用户扩展信息表",
      "fields": {
        "userId": { "type": "integer", "foreignKey": "users.id", "onDelete": "CASCADE" },
        "bio": { "type": "text" },
        "company": { "type": "string", "maxLength": 100 },
        "jobTitle": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 100 },
        "website": { "type": "string", "maxLength": 255 },
        "socialLinks": { "type": "json" },
        "preferences": { "type": "json" },
        "metadata": { "type": "json" },
        "createdAt": { "type": "datetime", "required": true },
        "updatedAt": { "type": "datetime", "required": true }
      },
      "indexes": [
        { "fields": ["userId"], "unique": true }
      ]
    },
    
    "subscriptions": {
      "description": "用户订阅表",
      "fields": {
        "id": { "type": "integer", "primaryKey": true, "autoIncrement": true },
        "userId": { "type": "integer", "foreignKey": "users.id", "onDelete": "CASCADE" },
        "planId": { "type": "string", "required": true, "maxLength": 50 },
        "planName": { "type": "string", "required": true, "maxLength": 100 },
        "status": {
          "type": "enum",
          "values": ["active", "canceled", "expired", "pending", "trial"],
          "default": "pending"
        },
        "billingCycle": {
          "type": "enum",
          "values": ["monthly", "quarterly", "yearly", "lifetime"],
          "default": "monthly"
        },
        "amount": { "type": "decimal", "precision": 10, "scale": 2, "required": true },
        "currency": { "type": "string", "maxLength": 3, "default": "CNY" },
        "startDate": { "type": "date", "required": true },
        "endDate": { "type": "date" },
        "trialEndDate": { "type": "date" },
        "canceledAt": { "type": "datetime" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "paymentGateway": { "type": "string", "maxLength": 50 },
        "gatewaySubscriptionId": { "type": "string", "maxLength": 255 },
        "autoRenew": { "type": "boolean", "default": true },
        "notes": { "type": "text" },
        "createdAt": { "type": "datetime", "required": true },
        "updatedAt": { "type": "datetime", "required": true }
      },
      "indexes": [
        { "fields": ["userId"] },
        { "fields": ["status"] },
        { "fields": ["planId"] },
        { "fields": ["startDate"] },
        { "fields": ["endDate"] }
      ]
    },
    
    "user_permissions": {
      "description": "用户权限表",
      "fields": {
        "userId": { "type": "integer", "foreignKey": "users.id", "onDelete": "CASCADE" },
        "permission": { "type": "string", "required": true, "maxLength": 100 },
        "grantedAt": { "type": "datetime", "required": true },
        "grantedBy": { "type": "integer", "foreignKey": "users.id" },
        "expiresAt": { "type": "datetime" },
        "metadata": { "type": "json" }
      },
      "indexes": [
        { "fields": ["userId", "permission"], "unique": true },
        { "fields": ["permission"] },
        { "fields": ["expiresAt"] }
      ]
    },
    
    "login_history": {
      "description": "用户登录历史",
      "fields": {
        "id": { "type": "integer", "primaryKey": true, "autoIncrement": true },
        "userId": { "type": "integer", "foreignKey": "users.id", "onDelete": "CASCADE" },
        "ipAddress": { "type": "string", "maxLength": 45 },
        "userAgent": { "type": "text" },
        "deviceType": { "type": "string", "maxLength": 50 },
        "browser": { "type": "string", "maxLength": 100 },
        "os": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 2 },
        "city": { "type": "string", "maxLength": 100 },
        "success": { "type": "boolean", "required": true },
        "failureReason": { "type": "string", "maxLength": 255 },
        "loginAt": { "type": "datetime", "required": true }
      },
      "indexes": [
        { "fields": ["userId", "loginAt"] },
        { "fields": ["ipAddress"] },
        { "fields": ["success"] },
        { "fields": ["loginAt"] }
      ]
    },
    
    "api_keys": {
      "description": "用户API密钥",
      "fields": {
        "id": { "type": "string", "primaryKey": true, "maxLength": 64 },
        "userId": { "type": "integer", "foreignKey": "users.id", "onDelete": "CASCADE" },
        "name": { "type": "string", "required": true, "maxLength": 100 },
        "keyHash": { "type": "string", "required": true, "maxLength": 255 },
        "lastUsed": { "type": "datetime" },
        "usageCount": { "type": "integer", "default": 0 },
        "rateLimit": { "type": "integer", "default": 1000 },
        "permissions": { "type": "json" },
        "status": {
          "type": "enum",
          "values": ["active", "revoked", "expired"],
          "default": "active"
        },
        "expiresAt": { "type": "datetime" },
        "createdAt": { "type": "datetime", "required": true },
        "updatedAt": { "type": "datetime", "required": true }
      },
      "indexes": [
        { "fields": ["userId"] },
        { "fields": ["status"] },
        { "fields": ["expiresAt"] }
      ]
    }
  },
  
  "enums": {
    "user_status": ["active", "inactive", "suspended", "pending"],
    "user_role": ["user", "premium", "admin", "super_admin"],
    "subscription_status": ["active", "canceled", "expired", "pending", "trial"],
    "billing_cycle": ["monthly", "quarterly", "yearly", "lifetime"],
    "api_key_status": ["active", "revoked", "expired"]
  },
  
  "relationships": [
    {
      "from": "user_profiles",
      "to": "users",
      "type": "one-to-one",
      "foreignKey": "userId"
    },
    {
      "from": "subscriptions",
      "to": "users",
      "type": "one-to-many",
      "foreignKey": "userId"
    },
    {
      "from": "user_permissions",
      "to": "users",
      "type": "one-to-many",
      "foreignKey": "userId"
    },
    {
      "from": "login_history",
      "to": "users",
      "type": "one-to-many",
      "foreignKey": "userId"
    },
    {
      "from": "api_keys",
      "to": "users",
      "type": "one-to-many",
      "foreignKey": "userId"
    }
  ],
  
  "defaultPermissions": {
    "user": [
      "read:own_profile",
      "update:own_profile",
      "create:share_link",
      "read:own_share_links",
      "read:own_analytics"
    ],
    "premium": [
      "read:own_profile",
      "update:own_profile",
      "create:share_link",
      "read:own_share_links",
      "read:own_analytics",
      "export:data",
      "advanced:analytics",
      "custom:domain"
    ],
    "admin": [
      "read:*",
      "update:*",
      "delete:*",
      "manage:users",
      "manage:subscriptions",
      "view:system_metrics"
    ],
    "super_admin": [
      "*"
    ]
  },
  
  "validationRules": {
    "username": {
      "pattern": "^[a-zA-Z0-9_]{3,50}$",
      "message": "用户名只能包含字母、数字和下划线，长度3-50位"
    },
    "email": {
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
      "message": "请输入有效的邮箱地址"
    },
    "password": {
      "minLength": 8,
      "requireUppercase": true,
      "requireLowercase": true,
      "requireNumbers": true,
      "requireSpecialChars": true,
      "message": "密码至少8位，包含大小写字母、数字和特殊字符"
    }
  }
}