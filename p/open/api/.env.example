# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai24x_subbrain01

# Redis (for caching)
REDIS_URL=redis://localhost:6379/0

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Security
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# 终端用户 JWT（www / a 子域）：须与行情官 `p/a` 的 AI24X_JWT_SECRET 配置为同一字符串
AUTH_JWT_EXPIRE_DAYS=7
APP_ENV=dev

# Feature Flags
ENABLE_RATE_LIMITING=true
ENABLE_CACHING=true

# Dev switches
# When true, the API can start without a DB connection (static site preview still works).
SKIP_DB_INIT=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# 106 短信（utf8 路径；程序用 GET + query 与浏览器示例一致）；勿将真实账号密码提交到 Git
# 国际对外（副脑04）默认关：邮箱注册；关时禁止手机号注册/发码（管理台「国内短信」同效，含子站内部密钥）
# SMS_106_ENABLED=false
# 若日后开国内手机注册，再改为 true（或管理台打开「国内短信」）
# SMS_106_ENABLED=true
# SMS_106_ACCOUNT=
# SMS_106_PASSWORD=
# SMS_106_ENDPOINT=http://sms.106jiekou.com/utf8/sms.aspx
# SMS_106_SIGN_NAME=
# 正文须与 106 平台审核一致；代码用 {code} 替换为验证码
# SMS_106_TEMPLATE=您的验证码是：{code}。请不要把验证码泄露给其他人。如非本人操作，可不用理会！
# SMS_SEND_COOLDOWN_S=60
# 生产强烈建议：请求头 X-SMS-Internal-Key 与下方一致后才允许发短信
# 须为强随机（建议 32+）；子站 a1 的 AI24X_SMS_INTERNAL_KEY 必须与此完全相同
# 改此值后须同步所有代理子站并重启对应 API 服务；勿用短口令/个人串
# SMS_INTERNAL_KEY=
# 管理后台可选独立钥（头 X-Admin-Key）；未配时管理接口仍接受 SMS_INTERNAL_KEY
# ADMIN_API_KEY=
# 生产 CORS（逗号分隔）；生产若留 * 会自动收窄为 www.ai24x.com,ai24x.com
# CORS_ORIGINS=https://www.ai24x.com,https://ai24x.com
# 防刷（单机内存；多副本请用 Nginx+limit_req 或 Redis；遇盗刷再收紧）
# SMS_IP_MIN_INTERVAL_S=2
# SMS_IP_MAX_SEND_PER_HOUR=150
# SMS_PHONE_MAX_SEND_PER_HOUR=25

# —— 邮箱验证码 SMTP（推荐 QQ/163/企业邮/Resend SMTP）——
# 配好后注册页不再回传验证码，只提示「请查收邮箱」
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@ai24x.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# EMAIL_OTP_SUBJECT=【AI24X】验证码
# 备用 SMTP（主通道失败自动切换；如 QQ 个人邮作应急备份）
# SMTP_BACKUP_HOST=smtp.qq.com
# SMTP_BACKUP_PORT=587
# SMTP_BACKUP_USER=you@qq.com
# SMTP_BACKUP_PASSWORD=授权码
# SMTP_BACKUP_FROM=you@qq.com
# SMTP_BACKUP_USE_TLS=true
# SMTP_BACKUP_USE_SSL=false
# 未配 SMTP 时本机联调是否在接口返回 local_code（生产即使为 true 也不会返回）
# EMAIL_OTP_EXPOSE_LOCAL_CODE=true
# 一次性邮箱域名拦截（默认开；追加域名逗号分隔；0=关闭）
# TOKEN_EMAIL_BLOCK_DISPOSABLE=1
# TOKEN_EMAIL_DISPOSABLE_EXTRA=

# —— Token 支付（notify 必须独立，勿改 a1 回调）——
# TOKEN_PAY_ENABLED=false
# 副脑/生产实付：TOKEN_PAY_ENABLED=true 且 TOKEN_PAY_MOCK_ENABLED=false（关模拟到账）
# 本机仅测履约：可 TOKEN_PAY_MOCK_ENABLED=true（或保持真支付关 + APP_ENV=local）
# TOKEN_PAY_MOCK_ENABLED=false
# 默认 true：商户号/私钥可直接复用行情官 a1（admin_config 或 a1 .env）；回调仍用下面 TOKEN_* URL
# TOKEN_PAY_REUSE_A1=true
# TOKEN_WECHAT_NOTIFY_URL=https://api.ai24x.com/v1/billing/wechat/notify
# TOKEN_ALIPAY_NOTIFY_URL=https://api.ai24x.com/v1/billing/alipay/notify
# TOKEN_ALIPAY_RETURN_URL=https://www.ai24x.com/console.html
# —— PayPal（国际 USD；审核中可先配 Sandbox）——
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# TOKEN_PAYPAL_RETURN_URL=https://www.ai24x.com/console.html
# TOKEN_PAYPAL_CANCEL_URL=https://www.ai24x.com/console.html
# 结账页语言（国际默认英文）；中文站可改 zh-CN
# TOKEN_PAYPAL_LOCALE=en-US
# 落地页：BILLING|LOGIN|NO_PREFERENCE（BILLING 略偏卡页，中国商户仍可能要求登录）
# TOKEN_PAYPAL_LANDING_PAGE=BILLING
# ————— Creem（国际 USD，MoR 模式；test / live 由 CREEM_MODE 切换）—————
# 注册: https://creem.io （店铺 ai24x）；每个套餐在 Creem 后台建商品后，
# 把商品 ID 填到管理后台「套餐管理」的 creem_product_id 字段。
# CREEM_MODE=test
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# CREEM_RETURN_URL=https://www.ai24x.com/console.html
# 上线前: CREEM_MODE=live + 正式 key + 生产 webhook（校验 creem-signature）
# 套餐默认（代码）：入门 $2/30万、开发 $20/4千万、Scale $99/1.8亿；改 CNY 分可用：
# TOKEN_PRICE_TOKEN_PACK_10K_FEN=1440
# TOKEN_PRICE_TOKEN_PACK_100K_FEN=14400
# TOKEN_PRICE_TOKEN_VIP_MONTH_50W_FEN=71280
# flash 估价锚（VIP 页 est_usd = 锚 × billing_mult）：
# TOKEN_FLASH_REF_USD_PER_M=0.45
# VIP 费率毛利护栏：估售价须 ≥ 混合成本 × 本加成（管理台保存时校验）
# TOKEN_MIN_MARKUP=2.0
# 若仍显示旧价：删掉 .env/管理台对套餐的旧分覆盖后重启
# 预充值额度有效期在代码套餐里：普通包 365 天，Scale 包 730 天；日/月赠送为短窗口
# —— 免费共享日额度（余额用尽自动降级 shared；可当获客亮点）——
# TOKEN_SHARED_DAILY_TOKEN_CAP=100000
# TOKEN_SHARED_DAILY_REQ_CAP=50
# TOKEN_SHARED_AUTO_DEGRADE=1
# TOKEN_SHARED_UPGRADE_FIRST=0
# Token 日报推飞书（可选）：python scripts_token_daily_report.py
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# （可选）不复用 a1 时再单独配 WECHAT_* / ALIPAY_*；有 *** 占位会被忽略并回退 a1

    # —— LLM：现阶段默认直连 DeepSeek（国内可充）；OR 有余额再切 openrouter ——
# TOKEN_LLM_UPSTREAM=direct
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# OR 为主时：建议仍配 DEEPSEEK_API_KEY；付费 L1/L2 默认直连优先，失败再 OR（均可关）
# TOKEN_LLM_DS_PREFER_PAID=1
# TOKEN_LLM_DS_FAILOVER=1
# FREE 链 L0 兜底（建议配，否则 L1 挂时无降级）：
# OR 模式下默认若已配硅基则 L0 走硅基（TOKEN_LLM_L0_USE_SILICON=0 可关）
# SILICONFLOW_API_KEY=
# SILICONFLOW_API_KEY_FREE=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
# TOKEN_LLM_L0_USE_SILICON=1
# 中国 VIP 点名（有 siliconflow_id）：默认硅基优先，失败再 OR（0=仍先 OR）
# TOKEN_LLM_VIP_SILICON_FIRST=1
# 真流式透传（OpenClaw）；0=回退假流式切片
# TOKEN_LLM_TRUE_STREAM=1
# TOKEN_LLM_STREAM_TIMEOUT_S=90
# TOKEN_LLM_MAX_INFLIGHT=24
# TOKEN_LLM_INFLIGHT_WAIT_S=3
# TOKEN_PROMPT_MAX_CHARS=120000
# tools / tool_calls 透传（OpenClaw 命令执行）；0=关闭
# TOKEN_LLM_TOOLS=1
# AI24X_BUILD_STAMP=20260730-core
# —— 以后 / 当前：OpenRouter 聚合（成本优先 DS Flash/Pro）——
# TOKEN_LLM_UPSTREAM=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_FREE=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://www.ai24x.com
# OPENROUTER_APP_NAME=AI24X
# OPENROUTER_MODEL_L0=openrouter/auto
# OPENROUTER_MODEL_L1=deepseek/deepseek-v4-flash
# 能力向：OPENROUTER_MODEL_L1=xiaomi/mimo-v2.5
# OPENROUTER_MODEL_L2=deepseek/deepseek-v4-pro
# OPENROUTER_MODEL_L3=openai/gpt-5-mini
# OPENROUTER_MODEL_EU=qwen/qwen3.7-plus
# TOKEN_REGION_ROUTING=0
# TOKEN_LLM_TIMEOUT_S=30
# —— 国际备用（填 Key 即启用骨架；显式 *_ENABLED=0 可关）——
# 推荐：Together=开源模备用；厂直连=GPT/Claude/Gemini 旗舰备用（勿指望 Together 顶旗舰）
# TOGETHER_API_KEY=
# TOGETHER_BASE_URL=https://api.together.xyz/v1
# TOKEN_UPSTREAM_TOGETHER_ENABLED=1
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# TOKEN_UPSTREAM_OPENAI_DIRECT_ENABLED=1
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# TOKEN_UPSTREAM_ANTHROPIC_DIRECT_ENABLED=1
# GOOGLE_AI_API_KEY=
# GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# TOKEN_UPSTREAM_GOOGLE_DIRECT_ENABLED=1
# 对外系统提示（可选覆盖；默认自称 AI24X、不报上游厂商）
# TOKEN_LLM_SYSTEM_PROMPT=
# QWEN_INTL_API_KEY=
# QWEN_INTL_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_INTL_MODEL=qwen-turbo

# —— BYOK 智能网关 ——
# BYOK_ENABLED=1
# BYOK_FALLBACK_TO_PLATFORM=1
# BYOK_CACHE_TTL_S=300
# Request cache uses REDIS_URL when reachable; otherwise in-process memory.
# BYOK_FREE_MONTHLY_REQUESTS=1000
# BYOK_ENFORCE_FREE_CAP=1
# Daily 09:00 renew mail: python scripts_byok_renewal_remind.py --apply
#   (or scripts/register_byok_renewal_cron.ps1 on Windows)