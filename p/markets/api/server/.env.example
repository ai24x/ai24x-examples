# AI24X Markets · 环境变量样例（复制为 .env；密钥类勿入 git / ops / 公网）
AI24X_MARKETS_PORT=18012
AI24X_MARKETS_CORS_ORIGINS=http://127.0.0.1:18012,https://markets.ai24x.com

# 与 api/.env 同值；core 产品运营代理 / 履约回调鉴权（本机缺此键会 403 bad_secret）
# MARKETS_FULFILL_SECRET=

# 后期可选：TuShare 美股（us_daily 单独 2000 元购买项，收入起来后再评估）
# AI24X_TUSHARE_TOKEN=
