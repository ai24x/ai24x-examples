/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 60rpx;
}
.hero { text-align: center; padding: 40rpx 0 36rpx; }
.logo {
  font-size: 64rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  background: linear-gradient(90deg, #fbbf24, #fb7185, #a78bfa);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.tag { font-size: 24rpx; color: #94a3b8; margin-top: 12rpx; }
.tier-card {
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  padding: 24rpx;
}
.tier-name { font-size: 36rpx; font-weight: 800; color: #fbbf24; }
.tier-meta { font-size: 22rpx; color: #94a3b8; margin-top: 8rpx; }

.rule { margin: 8rpx 0 32rpx; }
.rule-title { font-size: 28rpx; font-weight: 700; margin-bottom: 16rpx; color: #e2e8f0; }
.rule-line { font-size: 26rpx; color: #cbd5e1; line-height: 1.9; }
.hl { color: #fbbf24; font-weight: 700; }

.actions { display: flex; flex-direction: column; gap: 20rpx; margin-bottom: 32rpx; }
.double-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 8rpx;
}
.double-title { font-size: 28rpx; font-weight: 700; }
.double-sub { font-size: 22rpx; color: #94a3b8; margin-top: 4rpx; }
.start { width: 100%; }

.rank-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.rank-title { font-size: 28rpx; font-weight: 700; }
.rank-note { font-size: 20rpx; color: #64748b; }
.rank-row { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid rgba(255, 255, 255, 0.06); }
.rank-row:last-child { border-bottom: none; }
.rank-idx { width: 56rpx; font-size: 26rpx; color: #94a3b8; }
.rank-idx.top { color: #fbbf24; font-weight: 800; }
.rank-name { flex: 1; font-size: 26rpx; }
.rank-score { font-size: 26rpx; font-weight: 700; color: #fbbf24; }
.rank-empty { font-size: 24rpx; color: #64748b; text-align: center; padding: 20rpx 0; }

.footer { text-align: center; font-size: 20rpx; color: #475569; margin-top: 32rpx; line-height: 1.6; }