# Fisher API — 复制为 .env 后按需修改（勿提交 .env）
# 本服务仅支持 PostgreSQL（与仓库其他 API 真源一致）。

FISHER_ENV=dev
# 示例：本机已创建库 fisher、用户 fisher（与默认口令一致，生产务必修改）
#   psql -U postgres -c "CREATE USER fisher WITH PASSWORD 'fisher';"
#   psql -U postgres -c "CREATE DATABASE fisher OWNER fisher;"
FISHER_DATABASE_URL=postgresql+psycopg2://fisher:fisher@127.0.0.1:5432/fisher

# JWT（开发联调；生产务必换长随机串）
FISHER_JWT_SECRET=change-me-fisher-jwt
FISHER_JWT_EXPIRE_DAYS=7

# 默认抛竿冷却（秒）
FISHER_CAST_COOLDOWN_S=8

# CORS（开发可 *；生产改为具体域名）
FISHER_CORS_ORIGINS=*
