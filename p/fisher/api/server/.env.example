# Fisher API — 复制为 .env 后按需修改（勿提交 .env）

FISHER_ENV=dev
# SQLite 路径（相对 api/server 工作目录）
FISHER_DATABASE_URL=sqlite:///./data/fisher.db

# JWT（开发联调；生产务必换长随机串）
FISHER_JWT_SECRET=change-me-fisher-jwt
FISHER_JWT_EXPIRE_DAYS=7

# 默认抛竿冷却（秒）
FISHER_CAST_COOLDOWN_S=8

# CORS（开发可 *；生产改为具体域名）
FISHER_CORS_ORIGINS=*
