AI24X_ENV=dev
#
# DB switch (MVP default: sqlite; you can upgrade to PostgreSQL by switching these)
# - sqlite: uses AI24X_DB_PATH
# - pgsql: uses AI24X_DATABASE_URL
#
AI24X_DB_KIND=sqlite
AI24X_DB_PATH=./data/ai24x.db
AI24X_DATABASE_URL=
AI24X_JWT_SECRET=change-me
# Optional: support old browser tokens during secret rotation/accidents.
# Set this to the *previous* JWT secret to keep existing sessions valid temporarily.
# After users refresh/re-login and tokens are re-issued with AI24X_JWT_SECRET, you can clear this.
AI24X_JWT_SECRET_PREV=
AI24X_JWT_EXPIRE_DAYS=7

# 与主站 api 统一身份（须与 api 的 SECRET_KEY 一致；JWT 由 api 签发）
# 本地联调例：AI24X_IDENTITY_API_BASE=http://127.0.0.1:8000（或本机 core 实际端口）
# 生产（副脑03 a.ai24x.com）：必须 https://api.ai24x.com —— 禁止照抄 127.0.0.1，禁止指向错误端口
AI24X_IDENTITY_API_BASE=
# 代理 /v1/auth/sms/send：须与「当前对接的那台」主站 SMS_INTERNAL_KEY 完全一致（同 len、同值）
# 禁止把本机联调串（如 sms-internal-*-local-*）原样拷到生产；生产用独立强随机
AI24X_SMS_INTERNAL_KEY=
# 106 账号/密码/模板等也可仅在管理后台「短信」页写入 admin_config（随转发 JSON 提交主站，非空覆盖主站 .env）
# 以下身份/短信/微信支付项也可在管理后台填写（默认挂载见 AI24X_ADMIN_MOUNT_PATH；写入 admin_config，覆盖同名环境变量）

# --- Admin（管理后台）· 首推基线（小项目够用）---
# 1) AI24X_ADMIN_KEY：务必改为「密码器生成的长随机串」（建议 32+ 字符），勿用本文件示例值；勿提交 .env。
# 2) 浏览器入口：默认挂载见下方路径变量；勿在宣发/截图中暴露；公网域名务必 HTTPS（Cookie 在生产为 Secure）。
# 3) 启动时若密钥过短或疑似示例值，日志会出现 [admin-security] 告警（不阻断进程）。
# 4) 后期加强预案（SSH 转发、IP 白名单、VPN 等）：见 p/a/docs/管理后台-安全基线与后期加强预案.md
#
AI24X_ADMIN_KEY=change-me-admin
# 浏览器管理台挂载路径（未设置时默认 /admin20260501，登录页为 {路径}/login，对齐宣发 2026-05-01）。可不定期改成新日期或随机串；改后须同步 Nginx location。
# 例：AI24X_ADMIN_MOUNT_PATH=/admin20260501
# 若需恢复旧路径：AI24X_ADMIN_MOUNT_PATH=/admin
# 每 IP 每 15 分钟允许 POST /api/admin/login 次数（含成败），防撞库
# AI24X_ADMIN_LOGIN_MAX_PER_15M=24
#
# 总管手机 OTP：须在管理后台「系统配置」将 admin_browser_otp_enabled 设为 1 才会生效（数据库，默认关闭=预演省事）。
# 开启后：须配置下方白名单（与库表 admin_operators 启用行并集非空），浏览器登录须短信 OTP + 管理密钥；走主站真实短信时请配 AI24X_IDENTITY_API_BASE 且与主站 SMS_INTERNAL_KEY 一致。开关开启后不再使用 AI24X_ADMIN_OTP_DEV_CODE（仅开关关闭时联调码才生效）。
# AI24X_ADMIN_OTP_PHONES=13800138000,13900139000
# AI24X_ADMIN_OTP_TTL_S=300
# AI24X_ADMIN_OTP_SEND_PER_15M=8
# 非 prod：未配主站短信时发码接口 JSON 会带 dev_code；可选固定联调码：
# AI24X_ADMIN_OTP_DEV_CODE=123456

# 配额（MVP）
AI24X_FREE_DAILY_CAP=10
AI24X_FREE_WEEKLY=50
AI24X_VIP_DAILY_CAP=150
AI24X_VIP_WEEKLY=500
AI24X_DEDUPE_SECONDS=60

# CORS（MVP）
AI24X_CORS_ORIGINS=*

# Rate limiting（MVP）
AI24X_KLINE_PER_MINUTE=60
AI24X_SUGGEST_PER_MINUTE=120

# Market data robustness (MVP)
AI24X_KLINE_CACHE_TTL_S=30
AI24X_KLINE_FALLBACK_SINA=1

# Invite rewards（MVP, weekly bonus quota）
AI24X_INVITE_REWARD_INVITER_WEEKLY=100
AI24X_INVITE_REWARD_INVITEE_WEEKLY=50
AI24X_INVITE_WEEKLY_CAP=500
# Invite rewards（可选：把奖励也加到“日上限”，否则免费用户日上限10可能用不完周奖励）
AI24X_INVITE_REWARD_INVITER_DAILY=0
AI24X_INVITE_REWARD_INVITEE_DAILY=0

# Paid market-data provider（默认关闭；应急时开启）
# - off: 关闭
# - tushare: 使用 TuShare Pro（建议先做日K兜底；周/月由日K聚合）
AI24X_PAID_PROVIDER=off
# 默认策略：付费主源，公共源备份（付费源限流/不可用时自动回落）
AI24X_PAID_PROVIDER_PRIORITY=paid,tencent,eastmoney,sina

# TuShare Pro
# - token: 仅放环境变量，切勿提交到仓库
# - use_rt_k: 若你购买了 “A股实时日线(rt_k)” 权限，可在 period=day 且交易时段内优先走 rt_k
AI24X_TUSHARE_TOKEN=
AI24X_TUSHARE_USE_RT_K=0

# --- 微信支付 APIv3（国内先跑通 Native 扫码；支付宝/PayPal 后续另接）---
# 商户平台：https://pay.weixin.qq.com  证书与密钥在「账户中心 - API安全」
# NOTIFY_URL 须公网 HTTPS，与商户平台「支付配置 - Native支付回调链接」一致（本地可用 ngrok 等转发）
AI24X_WECHAT_MCH_ID=
AI24X_WECHAT_APP_ID=
AI24X_WECHAT_MCH_SERIAL_NO=
# apiclient_key.pem 本地绝对路径或相对 server 工作目录的路径
AI24X_WECHAT_MCH_PRIVATE_KEY_PATH=
# 32 位 APIv3 密钥
AI24X_WECHAT_API_V3_KEY=
AI24X_WECHAT_NOTIFY_URL=https://你的域名/api/billing/wechat/notify
# 默认官方域名；一般无需改
# AI24X_WECHAT_PAY_HOST=https://api.mch.weixin.qq.com
# 仅非 prod 且=1 时跳过回调验签（仅本地解密调试；上线务必=0）
# AI24X_WECHAT_NOTIFY_SKIP_VERIFY=0
# 标价（分）：体验 990=9.9元；月卡 9900=99元；年卡 99900=999元
# AI24X_PRICE_VIP_TRIAL_FEN=990
# AI24X_PRICE_VIP_MONTH_FEN=9900
# AI24X_PRICE_VIP_YEAR_FEN=99900
# 体验卡额度（低于月卡）：周上限 / 日上限
# AI24X_VIP_TRIAL_WEEKLY=100
# AI24X_VIP_TRIAL_DAILY_CAP=20
# 非 prod 且=1：微信下单按下方「分」真实扣款（联调用，如 10=0.1元）；生产环境无效
# AI24X_BILLING_DEV_REAL_PAY=0
# AI24X_BILLING_DEV_AMOUNT_FEN=10
