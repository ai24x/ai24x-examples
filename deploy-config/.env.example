# AI24X网站部署环境变量配置
# 复制此文件为 .env 并填写实际值

# ========== 基础配置 ==========
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*

# ========== 数据库配置 ==========
DATABASE_PATH=./data
DATABASE_BACKUP_PATH=./backups
BACKUP_INTERVAL=86400000  # 24小时备份一次

# ========== 认证安全 ==========
JWT_SECRET=your_secure_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=24h
SESSION_SECRET=your_session_secret_key_change_this
COOKIE_SECURE=true
COOKIE_HTTPONLY=true

# ========== Gitee Webhook ==========
GITEE_WEBHOOK_SECRET=ai24x_webhook_secret_2026
GITEE_WEBHOOK_PORT=8080
GITEE_REPO_URL=https://gitee.com/ai24x/ai24x-website.git

# ========== 支付配置 ==========
PAYMENT_GATEWAY=test_mode  # test_mode, stripe, alipay, wechat
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
ALIPAY_APP_ID=2021000123456789
ALIPAY_PRIVATE_KEY=your_alipay_private_key
WECHAT_MCH_ID=1230000109
WECHAT_API_KEY=your_wechat_api_key

# ========== 邮件服务 ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=AI24X Team <noreply@ai24x.com>
EMAIL_ADMIN=admin@ai24x.com

# ========== 监控告警 ==========
SENTRY_DSN=https://xxx@sentry.io/xxx
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
ALERTMANAGER_PORT=9093

# ========== CDN配置 ==========
CDN_ENABLED=false
CDN_DOMAIN=cdn.ai24x.com
CDN_PROVIDER=cloudflare  # cloudflare, aliyun, tencent

# ========== 国际节点配置 ==========
INTERNATIONAL_NODE_ENABLED=false
INTERNATIONAL_NODE_URL=https://sg.ai24x.com
SYNC_INTERVAL=300000  # 5分钟同步一次

# ========== 性能优化 ==========
CACHE_ENABLED=true
CACHE_TTL=300000  # 5分钟缓存
COMPRESSION_ENABLED=true
RATE_LIMIT_WINDOW=900000  # 15分钟窗口
RATE_LIMIT_MAX=100  # 每个IP最多100次请求

# ========== 调试配置 ==========
DEBUG=false
DEBUG_DATABASE=false
DEBUG_API=false
DEBUG_PAYMENT=false