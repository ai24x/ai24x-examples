APP_ENV=dev
SECRET_KEY=<CHANGE_ME_LONG_RANDOM>
AUTH_JWT_EXPIRE_DAYS=7
SKIP_DB_INIT=false

# 主站 auth 数据库（统一 PostgreSQL；禁止 sqlite）
DATABASE_URL=postgresql://ai24x_core:<PASSWORD>@127.0.0.1:5432/ai24x_core

# 106 短信（utf8）
SMS_106_ENABLED=true
SMS_106_ACCOUNT=<ACCOUNT>
SMS_106_PASSWORD=<PASSWORD>
SMS_106_ENDPOINT=http://sms.106jiekou.com/utf8/sms.aspx
SMS_106_SIGN_NAME=
SMS_106_TEMPLATE=您的验证码是：{code}。请不要把验证码泄露给其他人。如非本人操作，可不用理会！

# 内部鉴权：a1/a 子站代理发短信时带 X-SMS-Internal-Key（必须与子站 AI24X_SMS_INTERNAL_KEY 一致）
SMS_INTERNAL_KEY=<SAME_AS_AI24X_SMS_INTERNAL_KEY>

