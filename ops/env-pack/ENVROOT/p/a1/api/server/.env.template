AI24X_ENV=dev

# DB（副脑01预演口径：必须 pgsql + ai24x_a_pre）
AI24X_DB_KIND=pgsql
AI24X_DB_PATH=./data/ai24x.db
AI24X_DATABASE_URL=postgresql://ai24x_a:<PASSWORD>@127.0.0.1:5432/ai24x_a_pre

# Auth/Admin
AI24X_JWT_SECRET=<CHANGE_ME_LONG_RANDOM>
AI24X_JWT_EXPIRE_DAYS=7
AI24X_ADMIN_KEY=<CHANGE_ME_LONG_RANDOM>
AI24X_ADMIN_MOUNT_PATH=/admin20260501
AI24X_ADMIN_OTP_PHONES=
AI24X_ADMIN_OTP_DEV_CODE=

# 统一身份：主站 core（本机默认 8000）
AI24X_IDENTITY_API_BASE=http://127.0.0.1:8000
# 须与主站 api 的 SMS_INTERNAL_KEY 完全一致
AI24X_SMS_INTERNAL_KEY=<SAME_AS_SMS_INTERNAL_KEY>

# 微信支付（联调时填写；真实值不要入库）
AI24X_WECHAT_MCH_ID=
AI24X_WECHAT_APP_ID=
AI24X_WECHAT_MCH_SERIAL_NO=
AI24X_WECHAT_MCH_PRIVATE_KEY_PATH=
AI24X_WECHAT_API_V3_KEY=
AI24X_WECHAT_NOTIFY_URL=https://a1.ai24x.com/api/billing/wechat/notify
# 非 prod 且=1 才跳过回调验签；上线务必=0
AI24X_WECHAT_NOTIFY_SKIP_VERIFY=0

