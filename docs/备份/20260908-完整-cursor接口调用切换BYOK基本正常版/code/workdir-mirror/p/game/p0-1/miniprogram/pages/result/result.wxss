/* pages/result/result.wxss */
.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx;
}
.main-card {
  width: 100%;
  text-align: center;
  background: linear-gradient(170deg, #1e293b, #0f172a);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 32rpx;
  padding: 56rpx 40rpx;
}
.rank-icon { font-size: 88rpx; }
.title { font-size: 40rpx; font-weight: 800; margin-top: 12rpx; }
.title.newbest { color: #fbbf24; }
.tier { font-size: 26rpx; color: #a5b4fc; margin-top: 8rpx; }
.bigscore { font-size: 140rpx; font-weight: 900; color: #fbbf24; line-height: 1.1; margin: 16rpx 0 24rpx; }

.stats { display: flex; justify-content: space-around; margin: 20rpx 0 28rpx; }
.stat { display: flex; flex-direction: column; }
.stat-num { font-size: 40rpx; font-weight: 800; color: #ffffff; }
.stat-label { font-size: 22rpx; color: #94a3b8; margin-top: 6rpx; }

.sharebox {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #c7d2fe;
  margin-bottom: 28rpx;
}
.hl { color: #fbbf24; font-weight: 800; }

.actions { display: flex; flex-direction: column; gap: 20rpx; }
.tip { margin-top: 24rpx; font-size: 20rpx; color: #475569; text-align: center; line-height: 1.6; }