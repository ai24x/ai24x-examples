.container {
  padding: 30rpx;
  box-sizing: border-box;
}
.top-bar {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}
.fish-box {
  width: 100%;
  height: 600rpx;
  background: #e6f3f8;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}
.water-bg {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.bobber-wrap {
  z-index: 2;
}
.bobber {
  font-size: 80rpx;
}
.wave-pos {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(82, 155, 138, 0.45);
  pointer-events: none;
}
.hint {
  font-size: 24rpx;
  color: #666;
  margin-top: 16rpx;
}
.btn-group {
  margin-top: 40rpx;
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}
.catch-btn {
  background: #529b8a;
  color: #fff;
}
.pull-btn {
  background: #e67e57;
  color: #fff;
}
.sell-btn {
  background: #3d7a8c;
  color: #fff;
}
.hint-phase {
  display: inline-block;
  margin-right: 16rpx;
  color: #333;
}
.hint-mid {
  display: inline-block;
  color: #666;
}
.slogan {
  text-align: center;
  margin-top: 60rpx;
  font-size: 26rpx;
  color: #666;
  letter-spacing: 2rpx;
}
