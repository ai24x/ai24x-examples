# OpenClaw configuration with AI24X as LLM provider
[model]
provider = "ai24x"
model = "auto"

[model.ai24x]
base_url = "https://api.ai24x.com/v1"
api_key = "sk-your-key-here"

# Available model tiers:
# flash  - fast everyday tier ($0.35/M)
# pro    - high-value tier ($1.05/M)
# ultra  - premium tier
